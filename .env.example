# Copy to .env and adjust. No secrets are required to run this project locally.

# MLflow tracking backend (local sqlite file by default).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Serving
MODELS_DIR=models
# Model variant served by the API: int8 (default, passed the quality gate) or fp32
MODEL_VARIANT=int8
# Folder with MVTec test images offered as samples in the dashboard (optional).
SAMPLES_DIR=data/mvtec_ad
# ONNX Runtime intra-op threads (0 = let ONNX Runtime decide)
ORT_THREADS=0

# Deployment only (Azure, see README "Deployment").
# Private Hugging Face repo with models/ and samples/; when set, the API downloads it at
# startup instead of using MODELS_DIR / SAMPLES_DIR. Leave unset for local runs.
# HF_ASSETS_REPO=<user>/anomaly-mlops-assets
# Read-only Hugging Face token for that repo. scripts/deploy_azure.ps1 sends it to Azure as a
# secret; it is never committed or printed.
HF_TOKEN=
